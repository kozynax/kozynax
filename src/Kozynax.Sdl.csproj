<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace />
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Kozynax.Sdl</AssemblyName>
    <DefineConstants>$(DefineConstants);SDL_HOST</DefineConstants>
    <Version>0.0.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Windows display scaling stretches a DPI-unaware SDL window and blurs the UI. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) OR $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">
    <ApplicationManifest>ZXMAK2.Host.Sdl/Platform/Windows/app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.SharpZipLib.Patched" Version="1.2.0.9" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="Silk.NET.SDL" Version="2.22.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows / DX / WinForms host stay out of the SDL build -->
    <Compile Remove="ZXMAK2.DirectX\**" />
    <Compile Remove="ZXMAK2.Host.WinForms\**" />
    <Compile Remove="ZXMAK2.Hardware.WinForms\**" />
    <Compile Remove="ZXMAK2\Program.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <!-- Framework-era app.config is for WinForms; do not ship as *.dll.config -->
    <None Remove="ZXMAK2\app.config" />

    <EmbeddedResource Remove="ZXMAK2.DirectX\**" />
    <EmbeddedResource Remove="ZXMAK2.Host.WinForms\**" />
    <EmbeddedResource Remove="ZXMAK2.Hardware.WinForms\**" />
    <None Remove="ZXMAK2.DirectX\**" />
  </ItemGroup>

</Project>
