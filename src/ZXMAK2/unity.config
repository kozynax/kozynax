<?xml version="1.0" encoding="utf-8" ?>
<unity xmlns="http://schemas.microsoft.com/practices/2010/unity">
    <typeAliases>
        <typeAlias alias="IResolver" type="ZXMAK2.Dependency.IResolver, Kozynax" />
        <typeAlias alias="ResolverUnity" type="ZXMAK2.Dependency.ResolverUnity, Kozynax" />

        <typeAlias alias="IUserMessage" type="ZXMAK2.Host.Interfaces.IUserMessage, Kozynax" />
        <typeAlias alias="UserMessage" type="ZXMAK2.Host.Services.UserMessage, Kozynax" />

        <typeAlias alias="IUserQuery" type="ZXMAK2.Host.Interfaces.IUserQuery, Kozynax" />
        <typeAlias alias="UserQueryProxy" type="ZXMAK2.Host.Services.UserQueryProxy, Kozynax" />
        <typeAlias alias="UserQuery_WinForms" type="ZXMAK2.Host.WinForms.Services.UserQuery, Kozynax" />

        <typeAlias alias="IUserHelp" type="ZXMAK2.Host.Interfaces.IUserHelp, Kozynax" />
        <typeAlias alias="UserHelp_WinForms" type="ZXMAK2.Host.WinForms.Services.UserHelp, Kozynax" />

        <typeAlias alias="IOpenFileDialog" type="ZXMAK2.Host.Interfaces.IOpenFileDialog, Kozynax" />
        <typeAlias alias="OpenFileDialog_WinForms" type="ZXMAK2.Host.WinForms.Services.OpenFileDialog, Kozynax" />

        <typeAlias alias="ISaveFileDialog" type="ZXMAK2.Host.Interfaces.ISaveFileDialog, Kozynax" />
        <typeAlias alias="SaveFileDialog_WinForms" type="ZXMAK2.Host.WinForms.Services.SaveFileDialog, Kozynax" />

        <typeAlias alias="ILauncher" type="ZXMAK2.Host.Presentation.Interfaces.ILauncher, Kozynax" />
        <typeAlias alias="Launcher" type="ZXMAK2.Host.Presentation.Launcher, Kozynax" />

        <!-- main view -->
        <typeAlias alias="IMainViewModel" type="ZXMAK2.Host.Presentation.Interfaces.IMainViewModel, Kozynax" />
        <typeAlias alias="MainViewModel" type="ZXMAK2.Host.Presentation.MainViewModel, Kozynax" />

        <typeAlias alias="IMainView" type="ZXMAK2.Host.Presentation.Interfaces.IMainView, Kozynax" />
        <typeAlias alias="MainView_WinForms" type="ZXMAK2.Host.WinForms.Views.MainView, Kozynax" />
        <typeAlias alias="MainView_Xna" type="ZXMAK2.Host.Xna4.Views.MainView, Kozynax" />

        <typeAlias alias="IAboutView" type="ZXMAK2.Host.Presentation.Interfaces.IAboutView, Kozynax" />
        <typeAlias alias="AboutView_WinForms" type="ZXMAK2.Host.WinForms.Views.FormAbout, Kozynax" />

        <typeAlias alias="IKeyboardView" type="ZXMAK2.Host.Presentation.Interfaces.IKeyboardView, Kozynax" />
        <typeAlias alias="KeyboardView_WinForms" type="ZXMAK2.Host.WinForms.Views.FormKeyboardHelp, Kozynax" />

        <typeAlias alias="IMachineSettingsView" type="ZXMAK2.Host.Presentation.Interfaces.IMachineSettingsView, Kozynax" />
        <typeAlias alias="MachineSettingsView_WinForms" type="ZXMAK2.Host.WinForms.Views.FormMachineSettings, Kozynax" />

        <typeAlias alias="IMemoryMapView" type="ZXMAK2.Host.Presentation.Interfaces.IMemoryMapView, Kozynax" />
        <typeAlias alias="MemoryMapView_WinForms" type="ZXMAK2.Hardware.WinForms.FormMemoryMap, Kozynax" />

        <typeAlias alias="ITapeView" type="ZXMAK2.Host.Presentation.Interfaces.ITapeView, Kozynax" />
        <typeAlias alias="TapeView_WinForms" type="ZXMAK2.Hardware.WinForms.TapeForm, Kozynax" />

        <typeAlias alias="IFddDebugView" type="ZXMAK2.Host.Presentation.Interfaces.IFddDebugView, Kozynax" />
        <typeAlias alias="FddDebugView_WinForms" type="ZXMAK2.Hardware.WinForms.dbgWD1793, Kozynax" />

        <typeAlias alias="IDebuggerGeneralView" type="ZXMAK2.Host.Presentation.Interfaces.IDebuggerGeneralView, Kozynax" />
        <typeAlias alias="DebuggerGeneralView_WinForms" type="ZXMAK2.Hardware.WinForms.General.FormCpu, Kozynax" />

        <typeAlias alias="IDebuggerExView" type="ZXMAK2.Host.Presentation.Interfaces.IDebuggerExView, Kozynax" />
        <typeAlias alias="DebuggerExView_WinForms" type="ZXMAK2.Hardware.WinForms.General.Views.FormDebuggerEx, Kozynax" />

        <typeAlias alias="IDebuggerSprinterView" type="ZXMAK2.Host.Presentation.Interfaces.IDebuggerSprinterView, Kozynax" />
        <typeAlias alias="DebuggerSprinterView_WinForms" type="ZXMAK2.Hardware.WinForms.Sprinter.DebugForm, Kozynax" />

        <typeAlias alias="IDebuggerAdlersView" type="ZXMAK2.Host.Presentation.Interfaces.IDebuggerAdlersView, Kozynax" />
        <typeAlias alias="DebuggerAdlersView_WinForms" type="ZXMAK2.Hardware.Adlers.Views.FormCpu, Kozynax" />
        
        <!-- Host -->
        <typeAlias alias="IHostSound" type="ZXMAK2.Host.Interfaces.IHostSound, Kozynax" />
        <typeAlias alias="HostSound_Mdx" type="ZXMAK2.Host.WinForms.Mdx.DirectSound, Kozynax" />
        <typeAlias alias="HostSound_Xna" type="ZXMAK2.Host.Xna4.Xna.XnaSound, Kozynax" />

        <typeAlias alias="IHostKeyboard" type="ZXMAK2.Host.Interfaces.IHostKeyboard, Kozynax" />
        <typeAlias alias="HostKeyboard_Mdx" type="ZXMAK2.Host.WinForms.Mdx.DirectKeyboard, Kozynax" />
        <typeAlias alias="HostKeyboard_Xna" type="ZXMAK2.Host.Xna4.Xna.XnaKeyboard, Kozynax" />
        <typeAlias alias="HostKeyboard_WinForms" type="ZXMAK2.Host.WinForms.Controls.WinFormsKeyboard, Kozynax" />

        <typeAlias alias="IHostMouse" type="ZXMAK2.Host.Interfaces.IHostMouse, Kozynax" />
        <typeAlias alias="HostMouse_Mdx" type="ZXMAK2.Host.WinForms.Mdx.DirectMouse, Kozynax" />
        <typeAlias alias="HostMouse_Xna" type="ZXMAK2.Host.Xna4.Xna.XnaMouse, Kozynax" />

        <typeAlias alias="IHostJoystick" type="ZXMAK2.Host.Interfaces.IHostJoystick, Kozynax" />
        <typeAlias alias="HostJoystick_Mdx" type="ZXMAK2.Host.WinForms.Mdx.DirectJoystick, Kozynax" />

        <typeAlias alias="ISettingService" type="ZXMAK2.Host.Presentation.Interfaces.ISettingService, Kozynax" />
        <typeAlias alias="SettingService" type="ZXMAK2.Host.WinForms.Services.SettingService, Kozynax" />

        
        <!-- Circuits -->
        <typeAlias alias="IPsgChip" type="ZXMAK2.Hardware.Circuits.Sound.IPsgChip, Kozynax" />
        <typeAlias alias="PsgChip" type="ZXMAK2.Hardware.Circuits.Sound.PsgChip, Kozynax" />
    </typeAliases>

    <containers>
        <container>
            <!-- 
                Allowed values: winforms, xna 
            -->
            <instance name="viewType" value="winforms" type="System.String" />

            <register type="IResolver" mapTo="ResolverUnity" name="View">
                <constructor>
                    <param name="containerName">
                        <dependency name="viewType" />
                    </param>
                </constructor>
                <lifetime type="transient" />
            </register>

            <!-- Services -->
            <register type="ISettingService" mapTo="SettingService">
                <lifetime type="singleton" />
            </register>
            <register type="IUserMessage" mapTo="UserMessage">
                <lifetime type="transient" />
            </register>
            <register type="IUserQuery" mapTo="UserQueryProxy">
                <lifetime type="transient" />
            </register>


            <register type="ILauncher" mapTo="Launcher">
                <lifetime type="singleton" />
            </register>
            <register type="IMainViewModel" mapTo="MainViewModel">
                <lifetime type="transient" />
            </register>

            <!-- Circuits -->
            <register type="IPsgChip" mapTo="PsgChip">
                <lifetime type="transient" />
            </register>
        </container>

        <container name="winforms">
            <!-- Services -->
            <register type="IUserMessage" mapTo="UserMessage">
                <lifetime type="singleton" />
            </register>
            <register type="IUserQuery" mapTo="UserQuery_WinForms">
                <lifetime type="singleton" />
            </register>
            <register type="IUserHelp" mapTo="UserHelp_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IOpenFileDialog" mapTo="OpenFileDialog_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="ISaveFileDialog" mapTo="SaveFileDialog_WinForms">
                <lifetime type="transient" />
            </register>

            <!-- Emulator UI -->
            <register type="IMainView" mapTo="MainView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IAboutView" mapTo="AboutView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IKeyboardView" mapTo="KeyboardView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IMachineSettingsView" mapTo="MachineSettingsView_WinForms">
                <lifetime type="transient" />
            </register>
            
            <!-- Host WinForms -->
            <register type="IHostSound" mapTo="HostSound_Mdx">
                <constructor>
                    <param name="form" />
                    <param name="sampleRate" value="44100" />
                    <param name="bufferCount" value="4" />
                </constructor>
                <lifetime type="transient" />
            </register>
            <!--
            <register type="IHostKeyboard" mapTo="HostKeyboard_WinForms">
                <constructor>
                    <param name="form" />
                </constructor>
                <lifetime type="transient" />
            </register>
            -->
            <register type="IHostKeyboard" mapTo="HostKeyboard_Mdx">
                <constructor>
                    <param name="form" />
                </constructor>
                <lifetime type="transient" />
            </register>
            <register type="IHostMouse" mapTo="HostMouse_Mdx">
                <constructor>
                    <param name="form" />
                </constructor>
                <lifetime type="transient" />
            </register>
            <register type="IHostJoystick" mapTo="HostJoystick_Mdx">
                <constructor>
                    <param name="form" />
                </constructor>
                <lifetime type="transient" />
            </register>


            <!-- Device UI -->
            <register type="IMemoryMapView" mapTo="MemoryMapView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="ITapeView" mapTo="TapeView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IFddDebugView" mapTo="FddDebugView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IDebuggerGeneralView" mapTo="DebuggerGeneralView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IDebuggerExView" mapTo="DebuggerExView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IDebuggerSprinterView" mapTo="DebuggerSprinterView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IDebuggerAdlersView" mapTo="DebuggerAdlersView_WinForms">
                <lifetime type="transient" />
            </register>
        </container>

        <container name="xna">
            <!-- Services -->
            <register type="IUserMessage" mapTo="UserMessage">
                <lifetime type="singleton" />
            </register>
            <register type="IUserQuery" mapTo="UserQuery_WinForms">
                <lifetime type="singleton" />
            </register>
            <register type="IOpenFileDialog" mapTo="OpenFileDialog_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="ISaveFileDialog" mapTo="SaveFileDialog_WinForms">
                <lifetime type="transient" />
            </register>

            <!-- Emulator UI -->
            <register type="IMainView" mapTo="MainView_Xna">
                <lifetime type="transient" />
            </register>
            <register type="IAboutView" mapTo="AboutView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IKeyboardView" mapTo="KeyboardView_WinForms">
                <lifetime type="transient" />
            </register>

            <!-- Host XNA -->
            <register type="IHostSound" mapTo="HostSound_Xna">
                <constructor>
                    <param name="sampleRate" value="44100" />
                    <param name="bufferCount" value="4" />
                </constructor>
                <lifetime type="transient" />
            </register>
            <register type="IHostKeyboard" mapTo="HostKeyboard_Xna">
                <lifetime type="transient" />
            </register>
            <register type="IHostMouse" mapTo="HostMouse_Xna">
                <lifetime type="transient" />
            </register>

            <!-- Device UI -->
            <register type="IMemoryMapView" mapTo="MemoryMapView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="ITapeView" mapTo="TapeView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IFddDebugView" mapTo="FddDebugView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IDebuggerGeneralView" mapTo="DebuggerGeneralView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IDebuggerExView" mapTo="DebuggerExView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IDebuggerSprinterView" mapTo="DebuggerSprinterView_WinForms">
                <lifetime type="transient" />
            </register>
            <register type="IDebuggerAdlersView" mapTo="DebuggerAdlersView_WinForms">
                <lifetime type="transient" />
            </register>
        </container>
    </containers>
</unity>
