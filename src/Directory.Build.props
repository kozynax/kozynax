<Project>

  <!-- Shared by Kozynax.csproj and Kozynax.Sdl.csproj -->
  <PropertyGroup>
    <!-- Explorer / taskbar exe icon on Windows (WinForms + SDL). -->
    <ApplicationIcon>..\icons\kozynax.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\icons\kozynax.ico">
      <LogicalName>ZXMAK2.Resources.Icons.IconApp.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\icons\64x64.png">
      <LogicalName>ZXMAK2.Resources.Icons.IconApp.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="ZXMAK2.Resources\Icons\**\*">
      <LogicalName>ZXMAK2.Resources.Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="ZXMAK2.Resources\DeviceIcons\**\*">
      <LogicalName>ZXMAK2.Resources.DeviceIcons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="ZXMAK2.Resources\Pictures\**\*">
      <LogicalName>ZXMAK2.Resources.Pictures.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="ZXMAK2.Host\Keyboard.config" LogicalName="ZXMAK2.Host.Keyboard.config" />
    <EmbeddedResource Include="ZXMAK2\machines.config" LogicalName="ZXMAK2.machines.config" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ZXMAK2\roms\**\*" Condition="Exists('ZXMAK2\roms')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>roms\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>roms\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="ZXMAK2\ROMS.PAK" Condition="Exists('ZXMAK2\ROMS.PAK')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>ROMS.PAK</TargetPath>
    </Content>
  </ItemGroup>

</Project>
